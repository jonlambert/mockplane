{
  "name": "mockplane",
  "version": "0.3.0",
  "description": "Per-test server-side mocking for Playwright via MSW and cookie-forwarding",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "msw": "^2.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.0.0",
    "msw": "^2.0.0"
  }
}
